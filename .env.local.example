GEMINI_API_KEY=your-gemini-api-key-here

# Your production domain, no trailing slash — used to build absolute URLs for
# link previews (WhatsApp, LinkedIn, X, Slack). On Vercel this is optional:
# VERCEL_URL is used automatically when it is unset.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Supabase — Project Settings → API in your Supabase dashboard.
# Leave unset to run without accounts, billing, or the admin panel (the
# extraction tool works standalone in that mode, on GEMINI_API_KEY alone).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails that get free, unlimited, unpaid admin access —
# both to /admin and to extraction — the moment they sign up.
ADMIN_EMAILS=you@example.com

# Only set this to "true" after completing DOCUMENTATION.md section 11.2
# (Google Cloud OAuth client + enabling the provider in Supabase). Until
# then the "Continue with Google" button stays hidden rather than leading to
# a broken flow.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Stripe — Developers → API keys in your Stripe dashboard. Leave unset to
# run with accounts but no billing: everyone stays on the free plan.
STRIPE_SECRET_KEY=
# Developers → Webhooks → your endpoint → Signing secret, after you add
# https://yourdomain.com/api/stripe/webhook listening for:
#   checkout.session.completed, customer.subscription.updated,
#   customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
